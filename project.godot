; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Mario GD"
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameHandler="*res://scripts/handlers/game_handler.gd"
ControllerHandler="*res://scripts/handlers/controller_handler.gd"
SoundHandler="*res://scripts/handlers/sound_handler.gd"
MusicHandler="*res://scripts/handlers/music_handler.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=240
window/size/window_width_override=768
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/block_rewards/plugin.cfg")

